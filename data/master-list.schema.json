{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://darkstar1863.github.io/CouponRun/data/master-list.schema.json",
  "title": "Coupon Run master list",
  "description": "Validates data/master-list.json. vpFREE2 links are curator-supplied only, verified against vpFREE2 pages, never slug-guessed; a location without a verified page has vpfree2 null.",
  "type": "object",
  "required": [
    "listVersion",
    "curatorUpdatedAt",
    "categories",
    "locations",
    "books"
  ],
  "additionalProperties": false,
  "properties": {
    "listVersion": {
      "type": "integer",
      "minimum": 1
    },
    "curatorUpdatedAt": {
      "type": "string",
      "minLength": 1
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "shortTitle",
          "color",
          "displayOrder"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "shortTitle": {
            "type": "string",
            "minLength": 1
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "displayOrder": {
            "type": "integer"
          }
        }
      }
    },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "latitude",
          "longitude"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "latitude": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -180,
            "maximum": 180
          },
          "area": {
            "type": [
              "string",
              "null"
            ]
          },
          "address": {
            "type": [
              "string",
              "null"
            ]
          },
          "vpfree2": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          }
        }
      }
    },
    "books": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "shortTitle",
          "coupons"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "shortTitle": {
            "type": "string",
            "minLength": 1
          },
          "coupons": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "location",
                "title",
                "description",
                "categories",
                "startDate",
                "expirationDate",
                "source",
                "extra",
                "removed"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "location": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "categories": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "startDate": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "expirationDate": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceUrl": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "uri"
                },
                "extra": {
                  "type": "string"
                },
                "removed": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  }
}
